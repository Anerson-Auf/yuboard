FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_FLOWBOARD_API_URL=
ENV NEXT_PUBLIC_FLOWBOARD_API_URL=$NEXT_PUBLIC_FLOWBOARD_API_URL
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/app ./app
COPY --from=build /app/dist ./dist
COPY --from=build /app/.vinext ./.vinext
COPY --from=build /app/vite.config.ts /app/next.config.ts /app/tsconfig.json ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "3000"]
