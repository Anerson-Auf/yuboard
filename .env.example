# Local development. Disable TLS only for the local Docker PostgreSQL instance.
FLOWBOARD_DATABASE_URL=postgres://flowboard:flowboard_dev_only@localhost:5432/flowboard?sslmode=disable
FLOWBOARD_UPLOAD_DIR=uploads
FLOWBOARD_BIND_ADDR=127.0.0.1:8080
# Set true only behind HTTPS in a deployed environment. Keep false for local HTTP.
FLOWBOARD_COOKIE_SECURE=false
FLOWBOARD_API_ORIGIN=http://localhost:3000
# Set true only when a private reverse proxy overwrites X-Forwarded-For with the client IP.
FLOWBOARD_TRUST_PROXY=false
# Leave empty for the local Vite proxy and for the production nginx proxy.
NEXT_PUBLIC_FLOWBOARD_API_URL=

# Optional: refresh expiring Discord CDN links without storing Discord media.
# The bridge verifies a timestamped HMAC-SHA256 request and returns
# {"url":"https://cdn.discordapp.com/...","proxy_url":"..."}.
FLOWBOARD_DISCORD_MEDIA_REFRESH_URL=
FLOWBOARD_DISCORD_MEDIA_REFRESH_SIGNING_SECRET=

# Storage (MinIO/S3)
FLOWBOARD_S3_ENDPOINT=http://localhost:9000
FLOWBOARD_S3_BUCKET=flowboard-uploads
FLOWBOARD_S3_ACCESS_KEY=flowboard
FLOWBOARD_S3_SECRET_KEY=change-this-before-any-shared-environment
